{
  "env": {
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Users\\yepben\\scoop\\apps\\git\\current\\bin\\bash.exe",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0",
    "EDITOR": "akelpad"
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(curl:*)",
      "Bash(do:*)",
      "Bash(done:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(findstr:*)",
      "Bash(for:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(julia:*)",
      "Bash(kill:*)",
      "Bash(ls:*)",
      "Bash(python:*)",
      "Bash(rg:*)",
      "Bash(sd:*)",
      "Bash(sed:*)",
      "Bash(taskkill:*)",
      "Bash(tasklist:*)",
      "Bash(top:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/plans"
    ]
  },
  "model": "opusplan",
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Claude Docs"
    },
    {
      "serverName": "claude.ai Microsoft 365"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.sh",
            "timeout": 10,
            "statusMessage": "CLI 도구 가드 확인 중"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-env.sh"
          }
        ]
      }
    ]
  },
  "defaultShell": "bash",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-subagent.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "table-copy@sooop-mods": true,
    "telegram-bridge@sooop-mods": true,
    "agent-view-band@sooop-mods": true,
    "path-links@sooop-mods": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "sooop-mods": {
      "source": {
        "source": "directory",
        "path": "C:\\Users\\sooop\\.claude\\my-mods"
      }
    }
  },
  "language": "한국어",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "table-copy@sooop-mods": {
      "options": {
        "format": "tsv"
      }
    },
    "telegram-bridge@inline": {
      "options": {
        "chatId": "-1001243676050"
      }
    },
    "path-links@sooop-mods": {
      "options": {
        "editorArgs": "/n",
        "extensions": "md,json,txt,html,csv",
        "resolveFileNames": true
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "switchModelsOnFlag": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Internal package registry**: None configured",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
